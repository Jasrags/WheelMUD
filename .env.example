# WheelMUD environment variables.
#
# All values are optional. Env vars override the YAML config file at
# load time (see config.example.yaml). The catalog *_DIR vars below
# are env-only — they bypass the YAML config and point each
# embedded-FS catalog at an on-disk override.
#
# Copy to .env and source it, or set values in your service manager.

# --- Top-level server config (mirrors config.yaml fields) ---

# TCP bind address for the telnet listener.
LISTEN_ADDR=:2323

# HTTP bind for metrics / pprof / healthz (Phase J slice J5).
# Empty disables the metrics server.
METRICS_ADDR=127.0.0.1:9090

# SQLite DSN. ":memory:" works for ephemeral runs.
DB_DSN=wheelmud.db

# Directory the backup manager writes snapshots to. Empty disables
# backups (Phase J slice J4).
BACKUP_DIR=

# slog level: debug / info / warn / error.
LOG_LEVEL=debug

# --- Catalog overrides (env-only; bypass embedded FS) ---

# World content tree consumed by the YAML loader. Default is the
# embedded data/world tree shipped in the binary.
WORLD_DIR=./data/world

# Character-creation catalog (backgrounds / classes / feats / skills /
# weaves). Embedded by default.
# CHARGEN_DIR=./internal/chargen/default

# Quest catalog. Embedded by default.
# QUEST_DIR=./internal/quest/default

# Lua script catalog (Phase F #32). Embedded by default.
# SCRIPT_DIR=./internal/scripts/default

# Status-effect catalog (Phase E #25). Embedded by default.
# EFFECTS_DIR=./internal/effects/default
