<?xml version="1.0" encoding="UTF-8"?>
<!--
  WheelMUD Mudlet connection profile.
  Generated by `make mudlet-package`. Placeholders are substituted
  at build time from WHEELMUD_HOST and WHEELMUD_PORT (defaults
  localhost:2323). To override:
    make mudlet-package WHEELMUD_HOST=mymud.example.com WHEELMUD_PORT=2323
  Import via Mudlet's File → Import menu.
-->
<!DOCTYPE MudletProfile>
<MudletProfile version="1.0">
  <name>WheelMUD</name>
  <host>__WHEELMUD_HOST__</host>
  <port>__WHEELMUD_PORT__</port>
  <encoding>UTF-8</encoding>
  <auto_reconnect>no</auto_reconnect>
  <login_name></login_name>
  <password></password>
  <character_name></character_name>
  <history_length>250</history_length>
  <enable_GMCP>yes</enable_GMCP>
  <enable_MSDP>no</enable_MSDP>
  <enable_MSSP>yes</enable_MSSP>
  <enable_MSP>no</enable_MSP>
  <enable_MCCP>no</enable_MCCP>
  <enable_command_line>yes</enable_command_line>
  <enable_NAWS>yes</enable_NAWS>
  <enable_telnet_type>yes</enable_telnet_type>
  <enable_telnet_alternative_charset>UTF-8</enable_telnet_alternative_charset>
</MudletProfile>
